# Chap model contract for the persistence baseline.
#
# The contract is a directory with this file: chap-core parses it into
# ModelTemplateConfigV2, which forbids unknown fields, so everything here is a
# declared field. `uv_env` makes chap-core build the model's environment itself
# from pyproject.toml and uv.lock -- no Docker, no image, and the environment is
# pinned by a lockfile that travels with the model.
#
# The exchange is CSV files on disk: `train` is handed the training frame,
# `predict` is handed the expanding historic frame and the future covariate
# frame, and writes one row per (time_period, location) with one column per
# forecast draw.

name: persistence_baseline

target: disease_cases
supported_period_type: month
allow_free_additional_continuous_covariates: true
requires_geo: false

uv_env: pyproject.toml

entry_points:
  train:
    parameters:
      train_data: str
      model: str
    command: "python train.py {train_data} {model}"
  predict:
    parameters:
      historic_data: str
      future_data: str
      model: str
      out_file: str
    command: "python predict.py {model} {historic_data} {future_data} {out_file}"
