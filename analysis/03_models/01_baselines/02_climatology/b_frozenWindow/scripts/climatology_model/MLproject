# Chap model contract for the frozen-window seasonal climatology baseline.
#
# Byte-for-byte the sibling construction's contract but for its name, and deliberately
# so: the two children of this fork must reach `chap eval` by the identical route, or
# the fork would measure the route as well as the window. `uv_env` makes chap-core build
# the model's environment from the pyproject.toml and uv.lock in this directory, which
# resolve to the same six packages at the same versions as the sibling's, so the model's
# dependencies are pinned by a file that travels with the model.

name: seasonal_climatology_frozen

target: disease_cases
supported_period_type: month
allow_free_additional_continuous_covariates: true
requires_geo: false

uv_env: pyproject.toml

entry_points:
  train:
    parameters:
      train_data: str
      model: str
    command: "python train.py {train_data} {model}"
  predict:
    parameters:
      historic_data: str
      future_data: str
      model: str
      out_file: str
    command: "python predict.py {model} {historic_data} {future_data} {out_file}"
