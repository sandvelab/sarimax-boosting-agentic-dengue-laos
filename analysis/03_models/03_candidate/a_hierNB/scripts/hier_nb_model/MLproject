# Chap model contract for the hierarchical negative-binomial candidate.
#
# The contract is a directory with this file: chap-core parses it into
# ModelTemplateConfigV2, which forbids unknown fields, so everything here is a
# declared field. `uv_env` makes chap-core build the model's environment itself
# from pyproject.toml and uv.lock -- no Docker, no image, and the environment is
# pinned by a lockfile that travels with the model.
#
# What is new here, and was unexercised in this project until this model: the
# entry points take a `{model_config}` parameter. chap-core substitutes the name
# of the YAML file it writes into the run directory from whatever
# `chap eval --model-configuration-yaml` was given, so the model reads its
# configuration from a file rather than from a command line. `user_options`
# below declares what may be in that file; the values are assembled from the six
# fork nodes above this model by `../assemble_candidate_config.py`, which discovers
# them rather than listing them.

name: hier_nb_candidate

target: disease_cases
supported_period_type: month
required_covariates:
  - population
allow_free_additional_continuous_covariates: true
requires_geo: false

user_options:
  observation:
    type: string
    default: negative_binomial
    description: >
      Observation model for the counts. `negative_binomial` -- one distribution per
      cell with a dispersion shared across provinces. `zero_inflated` -- that
      distribution mixed with a point mass at zero. `hurdle` -- a logistic model for
      whether the month reports at all and a count model for how much it reports given
      that it does. Set by the 01_observation fork.
  covariates:
    type: array
    items:
      type: string
    default: [rainfall, mean_temperature]
    description: >
      Climate covariates entering the linear predictor. An empty list is a model with
      no climate term, which is one of the alternatives. Set by the 02_covariates fork.
  covariate_lags:
    type: array
    items:
      type: integer
    default: [2]
    description: >
      Lags, in months, at which every covariate above enters. Every covariate takes
      every lag: a per-covariate lag would be a sibling of the 02_covariates fork, not
      an option here. Set by the 02_covariates fork.
  population:
    type: string
    default: offset
    description: >
      How population enters. `offset` -- log(population) as a fixed offset, so the
      model forecasts an incidence rate. `covariate` -- an estimated coefficient on
      standardised log population. `ignored` -- population does not enter.
      Set by the 03_population fork.
  fit_time:
    type: string
    default: train
    description: >
      Where fitting happens. `train` -- fitted once on the training frame, and
      predict applies the stored fit. `predict` -- refitted inside every predict
      call on the expanded history. Set by the 04_fitTime fork.
  autoregressive:
    type: string
    default: none
    description: >
      Whether the last observed count enters the linear predictor. `none` -- it does
      not. `lag3` -- the count three months back, as standardised log1p, which is the
      freshest lag a three-month-ahead forecast can use at every horizon. Set by the
      05_autoregressive fork.
  year_variance:
    type: string
    default: shared
    description: >
      The province-year effect's variance. `shared` -- one variance for every province,
      so the annual spread is a constant multiplicative width. `province_scaled` -- one
      variance per province, estimated from that province's own years. Set by the
      06_yearVariance fork.
  seed:
    type: integer
    default: 0
    description: >
      Seed for every draw the model makes. Derived from the project seed by
      analysis/scripts/lib/project_seed.py and written in by the assembler; the
      default here is never the one used, because the assembler always sets it.

meta_data:
  display_name: Hierarchical negative-binomial GLM (Lao dengue case)
  description: >
    Monthly province counts as negative-binomial draws around a log-linear mean
    built from a population offset, a shared annual seasonality and lagged climate
    covariates, with province and province-year effects pooled toward a common
    level. Candidate 1 of the Lao dengue forecasting case.
  author: this repository
  organization: none

uv_env: pyproject.toml

entry_points:
  train:
    parameters:
      train_data: path
      model: str
      model_config: path
    command: "python train.py {train_data} {model} {model_config}"
  predict:
    parameters:
      historic_data: path
      future_data: path
      model: str
      out_file: path
      model_config: path
    command: "python predict.py {model} {historic_data} {future_data} {out_file} {model_config}"
